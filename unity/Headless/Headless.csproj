<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0162;CS0168;CS0219;CS0414;CS0649;CS0169</NoWarn>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../Assets/Scripts/Paint/**/*.cs" />
    <Compile Include="../Assets/Scripts/Game/**/*.cs" />
    <Compile Include="../Assets/Scripts/Audio/**/*.cs" />
    <!-- the pure-C# parts of the Unity host -->
    <Compile Include="../Assets/Scripts/App/TestScene.cs" />
    <Compile Include="../Assets/Scripts/App/PaintHelpers.cs" />
    <Compile Include="../Assets/Scripts/App/UI/AntiquePaint.cs" />
    <Compile Include="../Assets/Scripts/App/UI/AntiqueShareCard.cs" />
  </ItemGroup>
</Project>
